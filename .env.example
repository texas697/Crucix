# ============================================
# Crucix Intelligence Engine — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === OSINT Source API Keys ===

# Federal Reserve Economic Data (optional; without a key the public graph CSV is used. Free key: fred.stlouisfed.org/docs/api)
FRED_API_KEY=
# NASA FIRMS fire data (optional; without a key the public 24 h VIIRS downloads are used. Free key: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# Energy Information Administration (free: api.eia.gov/register)
EIA_API_KEY=
# Maritime AIS data (aisstream.io, free): live vessel positions around 13 chokepoints via a persistent WebSocket
AISSTREAM_API_KEY=
# OpenSky Network API client (opensky-network.org -> Account -> API client). Optional: without it the sweep
# makes one anonymous global call (4 of the 400 daily credits) and falls back to adsb.lol when throttled.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional relay when the host cannot reach opensky-network.org (Google Cloud IPs are blocked):
# run deploy/opensky-relay.py elsewhere and point at it. The token must match RELAY_TOKEN on the relay.
OPENSKY_RELAY_URL=
OPENSKY_RELAY_TOKEN=
# Minimum gap between adsb.lol requests in ms (it throttles bursts; ~4 s is reliably accepted)
ADSB_LOL_GAP_MS=4000
# Cloudflare Radar internet outages & traffic anomalies (free: dash.cloudflare.com/profile/api-tokens, Account Analytics Read)
# Cloudflare Radar: custom token with Account → Radar → Read (dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=15

# === Login gate (Firebase Auth) ===
# Default AUTH_MODE=firebase: every page and API call requires a signed-in user.
# Paste the JSON from `firebase apps:sdkconfig web` on ONE line (no inline comments).
FIREBASE_WEB_CONFIG=
# Optional Web API key for the mobile auth endpoints (lets a Firebase-SDK-free client obtain an
# ID token). Falls back to the apiKey inside FIREBASE_WEB_CONFIG when left blank.
FIREBASE_WEB_API_KEY=
# Set to off ONLY for private local use — makes the dashboard public.
AUTH_MODE=firebase
# Optional: restrict who may sign in (comma-separated). Leave blank to allow anyone who signs up.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Set to false to disable self-service account creation on the login page
AUTH_ALLOW_SIGNUP=true
# Google sign-in: serve Firebase's auth helper from this app's own hostname (fixes popups/redirects under
# third-party-cookie blocking). Requires adding https://<your-host>/__/auth/handler to the OAuth client's
# authorized redirect URIs and https://<your-host> to its JavaScript origins in Google Cloud Console first.
AUTH_SAME_ORIGIN_HELPER=false
# Session cookie lifetime in days
AUTH_SESSION_DAYS=14

# === BYOK — users bring their own LLM key ===
# 32-byte key that encrypts user API keys at rest in Firestore. Generate: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=
# Minimum seconds between manual "generate ideas" calls per user
BYOK_IDEAS_MIN_INTERVAL_S=60

# === Readers Digest ===
# Think-tank + policy-press write-ups. Ingest runs after every sweep (set false to only use the scheduler/endpoint).
DIGEST_AFTER_SWEEP=true
# Cap new articles per ingest run and how old a feed item may be (days)
DIGEST_MAX_PER_RUN=40
DIGEST_MAX_AGE_DAYS=4
# Hours of GDELT 15-minute event exports to load per sweep for the conflict layer (1-24, 4 files per hour)
GDELT_WINDOW_HOURS=6
# Optional: Tavily web search key improves "Read more about it" (GDELT is used for free otherwise)
TAVILY_API_KEY=

# === Cloud hosting ===
# Where sweep history / delta memory live (mount a persistent volume here in the cloud)
RUNS_DIR=
# internal = in-process timer (default). external = a scheduler POSTs /api/internal/sweep every N minutes.
SWEEP_MODE=internal
# Shared secret the scheduler sends as X-Sweep-Token
SWEEP_TRIGGER_TOKEN=

# === Map area briefs (draw a shape on the map → places → recent news → AI brief) ===
# Briefs use the signed-in user's own key when they saved one, otherwise the operator LLM below (budgeted).
BRIEF_SHARED_PER_USER_HOUR=30
BRIEF_SHARED_PER_DAY=400
# Let the operator key also write Readers Digest summaries for every ingested article (≈40 per ingest, costs add up)
DIGEST_OPERATOR_WRITEUPS=false

# === Operator LLM Layer (optional) ===
# A server-wide key used for map area briefs and as the fallback ideas source.
# Signed-in users can still bring their own key — that is what the dashboard uses for THEIR ideas.
# Provider options: anthropic | openai | openai-compatible | gemini | codex | openrouter | minimax | mistral | ollama | grok
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b | grok: grok-4-latest
LLM_MODEL=
# Base URL for openai-compatible endpoints (Groq, Together, LM Studio…) or a non-default Ollama host
LLM_BASE_URL=
# Legacy alias for LLM_BASE_URL when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=

# Safecast nuclear watch: sensors older than this are ignored; site median above this dose rate (µSv/h) flags an anomaly
SAFECAST_WINDOW_DAYS=30
SAFECAST_ALERT_USVH=0.5

# Health watch (WHO Disease Outbreak News + CDC feeds, no key). An outbreak stays listed for WHO_ACTIVE_DAYS after its
# last WHO notice; WHO_RECENT_DAYS bounds the 'recent notices' list.
WHO_ACTIVE_DAYS=90
WHO_RECENT_DAYS=30

# Disasters / outages (GDACS and IODA, no key). GDACS keeps closed events listed; drop them this many days after
# their end date. IODA alerts are read over this window.
GDACS_STALE_DAYS=10
IODA_WINDOW_HOURS=24

# KiwiSDR status probes via the droplet relay (defaults to AIS_RELAY_URL / AIS_RELAY_TOKEN). Needed on Google Cloud,
# whose egress ranges are on the KiwiSDR community blacklist.
KIWISDR_RELAY_URL=
KIWISDR_RELAY_TOKEN=

# Telegram read-only chats (/telegram). Fill via: npm run telegram:auth
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
